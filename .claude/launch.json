{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Field Inspection API (server.ts)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "port": 3000
    },
    {
      "name": "Field Inspection CLI (index.ts)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "jirayu-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", "-p", "8099", "-c-1"],
      "port": 8099
    }
  ]
}
